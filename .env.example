# Names only. Copy to .env and fill in locally; never commit real values.

# Server-side only (never use a VITE_ prefix for the key)
OPENROUTER_API_KEY=
# Optional; server falls back to the PRD 11.2 default model when empty
OPENROUTER_MODEL=

# Client flag: set to 1 to return fixed mock AI responses (dev only, no key needed)
VITE_AI_MOCK=
